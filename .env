# Your private settings. Paste your Meta Model API key below ON YOUR PC ONLY.
#
#   - Do NOT type your real key into this file on the GitHub website.
#   - After pasting it on your PC, run once:  git update-index --skip-worktree .env
#     so git never uploads your key with a later commit.

MODEL_API_KEY=paste-your-key-here

MODEL_BASE_URL=https://api.meta.ai/v1
MODEL_VISION_MODEL=muse-spark-1.3
MODEL_TEXT_MODEL=muse-spark-1.3
MODEL_VOICE_MODEL=muse-voice-transcribe-1.0
MODEL_REASONING_EFFORT=low
