# Copy this file to ".env" (same folder) and fill in your key.
# ".env" is git-ignored: it never goes to GitHub. Never put the key in any other file.

LLAMA_API_KEY=paste-your-key-here

# Use the base URL and model names from the hackathon's API instructions.
# Defaults below are for the Meta Llama API (OpenAI-compatible endpoint).
LLAMA_BASE_URL=https://api.llama.com/compat/v1
LLAMA_VISION_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8
LLAMA_TEXT_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8
