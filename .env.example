# Copy this file to ".env" in the same folder and paste your key below.
# ".env" is git-ignored: it never goes to GitHub. Never put the key in any other file.

# Meta Model API key (the hackathon's $150 credit). Create it in your Meta developer dashboard.
MODEL_API_KEY=paste-your-key-here

# The settings below are the defaults; you only need them to change something.
# MODEL_BASE_URL=https://api.meta.ai/v1
# MODEL_VISION_MODEL=muse-spark-1.3          # reads bill photos, UPI screenshots, statements
# MODEL_TEXT_MODEL=muse-spark-1.3            # reads Hinglish / Devanagari messages, PDFs, feedback
# MODEL_VOICE_MODEL=muse-voice-transcribe-1.0  # voice notes (falls back to local Whisper)
# MODEL_REASONING_EFFORT=low                 # minimal | low | medium | high (higher costs more)

# To run on open Llama weights instead (e.g. a local Ollama), set:
# MODEL_BASE_URL=http://localhost:11434/v1
# MODEL_VISION_MODEL=llama3.2-vision
# MODEL_TEXT_MODEL=llama3.2-vision
