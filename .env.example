# Copy the lines you need into ".env" in the same folder. Put your real key only in .env on your own
# computer, never in any other file, and never push it to GitHub.

# Meta Model API key (the hackathon's $150 credit). Create it in your Meta developer dashboard.
MODEL_API_KEY=paste-your-key-here

# ---- Which models (defaults shown; you only need these to change something) ----
# MODEL_PROVIDER=meta                        # meta = Muse on the Meta Model API, ollama = open Llama on this computer
# MODEL_BASE_URL=https://api.meta.ai/v1
# MODEL_VISION_MODEL=muse-spark-1.3          # reads bill photos, UPI screenshots, statements
# MODEL_TEXT_MODEL=muse-spark-1.3            # reads Hinglish / Hindi messages, PDFs, feedback
# MODEL_VOICE_MODEL=muse-voice-transcribe-1.0  # voice notes (falls back to local Whisper)
# MODEL_REASONING_EFFORT=low                 # minimal | low | medium | high (higher costs more)

# To use open Llama instead: install Ollama, run "ollama pull llama3.2-vision", then set only
# MODEL_PROVIDER=ollama

# ---- How Khata reads the parts of the brief that are open (defaults shown; see PROBLEM.md) ----
# KHATA_INTEREST_DAYS=to_window_end          # interest from the due date to the end of the 7-day window | one_day | full_window
# KHATA_SCHEME_SCALING=by_wording            # "10 pe 1" scales, "20 lo 2 free" doesn't | always | never
# KHATA_DUPLICATE_WINDOW_DAYS=2              # how far apart two deliveries can be and still count as the same one
# KHATA_VOICE_ONLY_AUTOSEND=no               # may a claim resting only on a voice note be sent automatically
# KHATA_AUTOSEND_LIMIT=2000                  # autonomous mode only sends claims under this many rupees
# KHATA_AUTOSEND_MIN_CONFIDENCE=0.75
# KHATA_CREDIT_DAYS=30                       # default credit period when a distributor hasn't said one
# KHATA_INTEREST_RATE=0.18                   # default yearly interest (0.18 = 18%)
# KHATA_RATE_TOLERANCE=0.5                   # rupees per unit ignored as rounding
